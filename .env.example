PORT=3000
HOST=127.0.0.1
DATA_DIR=./data

# Any OpenAI-compatible chat completions endpoint (defaults to Ollama)
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=llama3.2
# Allow slower local models up to 5 minutes by default
LLM_TIMEOUT_MS=300000

# Markdown is always available
MARKDOWN_EXPORT_DIR=./exports

# Optional WordPress connector
WP_URL=
WP_USERNAME=
WP_APP_PASSWORD=

# Optional GitHub connector (GITHUB_REPO is owner/repository)
GITHUB_TOKEN=
GITHUB_REPO=
GITHUB_BRANCH=main

# Optional generic webhook connector
WEBHOOK_URL=
WEBHOOK_SECRET=

# Optional Telegram and Discord connectors
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=

# Security: leave disabled unless you intentionally audit a trusted local URL
ALLOW_PRIVATE_FETCH=0
